{
  "name": "hw21",
  "version": "1.0.0",
  "description": "Cucumber.js and Playwright UI tests for demoqa.com with Allure Reporter",
  "type": "module",
  "scripts": {
    "test": "cucumber-js --config cucumber.cjs --profile local",
    "report:generate": "allure generate ./allure-results --clean -o ./allure-report",
    "report:open": "allure open ./allure-report"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@stylistic/eslint-plugin-ts": "^4.4.1",
    "@types/node": "^26.1.0",
    "allure-commandline": "^2.43.0",
    "allure-cucumberjs": "^3.10.2",
    "eslint": "^10.6.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unicorn": "^69.0.0",
    "globals": "^17.6.0",
    "prettier": "^3.9.3",
    "tsx": "^4.22.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0"
  },
  "dependencies": {
    "@cucumber/cucumber": "^13.0.0",
    "@cucumber/pretty-formatter": "^4.0.0",
    "@playwright/test": "^1.61.1"
  }
}
